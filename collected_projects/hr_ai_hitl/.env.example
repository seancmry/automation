# --- Pick ONE free (or paid) provider ---
# Auto-picks: Google → Groq → OpenAI (first key found)
# Or force with: AI_PROVIDER=google|groq|openai
#
# SAFE SETUP (do not paste keys in Cursor chat):
#   npm run setup:keys        # masked prompts in your terminal
#   npm run keys:slots        # shows where to paste (this file → .env.local)
#   npm run keys:check        # SET / empty only — never prints secrets

# FREE (recommended): Google AI Studio / Gemini
# https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_MODEL=gemini-flash-latest

# FREE alternative: Groq
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Paid: OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional force (uncomment one)
# AI_PROVIDER=google
# AI_PROVIDER=groq
# AI_PROVIDER=openai

# Odoo mode: "mock" (default, no Docker) | "live"
ODOO_MODE=mock

# Only needed when ODOO_MODE=live
ODOO_URL=http://localhost:8069
ODOO_DB=hr_hitl_demo
ODOO_USERNAME=admin
ODOO_PASSWORD=admin
ODOO_DEFAULT_PARTNER_ID=1
